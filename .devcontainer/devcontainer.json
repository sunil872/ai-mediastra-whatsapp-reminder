{
  "name": "RefillCare (Python 3.13)",
  // Same Python as the production image (Dockerfile) and CI.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app_refillcare.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && echo 'Requirements installed'",
  "postAttachCommand": {
    "server": "streamlit run app_refillcare.py --server.headless true"
  },
  "portsAttributes": {
    "8501": {
      "label": "RefillCare (Streamlit)",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "RefillCare API"
    }
  },
  "forwardPorts": [
    8501,
    8000
  ]
}
