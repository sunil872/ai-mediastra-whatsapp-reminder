# ============================================
# AI Mediastra WhatsApp Reminder - Environment
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

# --- Xinno WhatsApp API Credentials ---
# (Do NOT fill these until you have real credentials)
XINNO_API_URL=https://whatsapp.xinno.in/REST/directApi/message
XINNO_API_KEY=your_xinno_api_key_here
XINNO_WABA_NUMBER=919515473474

# ============================================
# EXISTING TEXT CAMPAIGN
# ============================================
WHATSAPP_TEMPLATE_NAME=reminder_refill_followup_v3
WHATSAPP_TEMPLATE_LANGUAGE=en

# ============================================
# NEW IMAGE CAMPAIGN
# ============================================
# (Used by app_image_campaign.py only — does NOT affect the text campaign)
XINNO_IMAGE_TEMPLATE_NAME=refill_reminder_image
XINNO_IMAGE_URL=https://res.cloudinary.com/troli5kq/image/upload/f_auto,q_auto/PHARMA_HUBB_-_medicine_Refill_Reminder_Image_Template

# --- Cloudinary Image Upload (Used for uploading device images) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# --- Business Details ---
MEDICAL_STORE_NAME=PHARMA HUBB

MEDICAL_STORE_CONTACT=+91 90000 00000

# ============================================
# DEPLOYMENT (AWS: ECS + RDS PostgreSQL + S3)
# ============================================
# REFILLCARE_ENV=development          # production: fails closed without API key / webhook secret, JSON logs, no /docs
# DATABASE_URL=postgresql+psycopg://user:pass@<rds-endpoint>:5432/refillcare   # unset = local SQLite (enterprise.db)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# REFILLCARE_MODEL_BUCKET=            # S3 bucket for model files (unset = local disk only)
# REFILLCARE_MODEL_PREFIX=refillcare/models
# REFILLCARE_MODEL_KEEP=3             # candidate model files kept per store (production + shadow always kept)
# REFILLCARE_LOG_FORMAT=json          # json | text (phones are masked in every log line)
# REFILLCARE_WARM_RULES=true          # API loads the pharmacist rules (Supabase) in the background at start-up
# REFILLCARE_LOG_LEVEL=INFO
# REFILLCARE_WORKER_POLL_SECONDS=5    # background worker: python -m refillcare.jobs.worker
# REFILLCARE_SCHEDULE_EVERY_SECONDS=3600   # daily stage expiry, monthly retrain / salt priors per store
# REFILLCARE_DISABLE_SCHEDULER=false

# ============================================
# API PROTECTION (service-to-service: the Mediastra backend calls this API)
# ============================================
# Every /api route needs X-API-Key (reads too - they return patient data) and X-Store-Id.
# If unset in development, only this machine is accepted; in production the API refuses to serve.
REFILLCARE_API_KEY=
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# WHATSAPP_WEBHOOK_SECRET=            # HMAC secret (X-Hub-Signature-256) or token (X-Webhook-Token); required in production
# Streamlit has no login of its own (Mediastra handles tenant > store logins): keep it on a private network / IP allow-list.
# REFILLCARE_RATE_LIMIT_PER_MIN=240   # per client; uploads cost 10
# MAX_UPLOAD_MB=50
# REFILLCARE_MAX_UPLOAD_ROWS=2000000
# REFILLCARE_ENABLE_DOCS=false        # expose /docs in production
# REFILLCARE_DATA_DIR=data/refillcare               # store data folder (sales CSV, processed/, models)
# REFILLCARE_STORE_ID=store-1                        # default store (requests without X-Store-Id; local Streamlit)
# REFILLCARE_ALLOWED_STORES=store-1,store-2          # stores the Streamlit app may open via ?store_id=<id> (Mediastra link).
#                                                    # Production: required to open any store other than REFILLCARE_STORE_ID.
# REFILLCARE_SALT_CATALOG=data/refillcare/SALT ITEMS LIST.csv   # item -> salt master (Code, Item Name, PACK, SALT, CATEGORY, ITEMCAT)

# ============================================
# SAFETY & ML
# ============================================
REFILLCARE_LIVE_REQUIRES_APPROVAL=true             # live WhatsApp sends need pharmacist APPROVED stages
REFILLCARE_HOLDOUT_PCT=10                         # no-reminder control group (% of patients, by mobile) to measure uplift; 0 = off
# REFILLCARE_HOLDOUT_SALT=refillcare-holdout-v1     # change to re-draw the control group (e.g. new pilot)
REFILLCARE_IDENTITY_GUARD=true                     # block outreach when one customer key has several mobiles
REFILLCARE_MAX_INTERVAL_DAYS=120                   # global refill interval safety cap
REFILLCARE_MAX_BACKUPS=1                           # legacy CLI master-CSV backups only (uploads append to the DB; use RDS snapshots)
# REFILLCARE_MAX_DATA_LAG_DAYS=2                   # live sends blocked when the latest sale is older than this
# REFILLCARE_STALE_DATA_GUARD=true
# REFILLCARE_REQUIRE_INVOICE_NUMBER=false          # reject files without an invoice-number column
# REFILLCARE_NON_SALE_PREFIXES=CN/,SR/,CR/,DN/,RT/,RET/,CRN/   # never counted as customer sales
# REFILLCARE_MAX_INVALID_DATE_PCT=5                # block an upload when more dates than this are unreadable
SUPABASE_RULES_RETRY_SECONDS=60                    # Supabase outage: retry rules at most once per minute
# Promotion gate (defaults shown)
# Rolling train / validation / test windows (re-derived from the latest sale on every run / ingest)
# ML_TEST_WINDOW_DAYS=30            # last N labelled days -> promotion gate only
# ML_VALIDATION_WINDOW_DAYS=30      # N days before test -> model selection
# ML_CENSOR_BUFFER_DAYS=90          # test window ends this many days before the last sale; also the max scored refill
# ML_RETRAIN_AFTER_DAYS=30          # flag a retrain once this much new training data exists
# ML_MAX_EVAL_EVENTS=0              # events per evaluation run; 0 = all qualifying events (tighter promotion gate)
# ML_AUTO_RETRAIN_ON_INGEST=false   # queue a retrain cycle after a sales upload when due
# ML_AUTO_PROMOTE=false             # let that cycle promote (still only if the gate approves)
# Training
# ML_TARGET_TRANSFORM=log_ratio_to_personal_median   # or "days" (raw interval)
# ML_TRAIN_LABEL_HORIZON_DAYS=90    # skip purchases this close to the cutoff; max training target (default = censor buffer)
# Prediction rules - all off until `python scripts/ml_cli.py rules-ab` shows a gain
# REFILLCARE_RULE_HIGH_STABILITY_MEDIAN=false   # high-stability + normal quantity -> personal median
# REFILLCARE_RULE_INSULIN_MEDIAN=false          # insulin / devices -> personal median
# REFILLCARE_RULE_DOM_ANCHOR=false              # snap monthly buyers to their usual day of month
# REFILLCARE_RULE_QUANTITY_SCALING=true        # fewer strips than usual (<2/3) -> earlier reminder (on: 37% -> 47% within 7 days)
# REFILLCARE_RULE_PATH_B_MODE=dos               # short histories: dos | shrink | blend (salt prior)
# REFILLCARE_PATIENT_IDENTITY=name_mobile       # name_mobile (default: same name + different phone = different patient) | name (legacy, unsafe)
# REFILLCARE_ITEM_GROUPING=item                 # item | salt (brand / strength switches continue one refill cycle)
#   After switching either one, run once: python scripts/rekey_reminders.py --apply
# REFILLCARE_RULE_DEVICE_CAP_MODE=strict       # insulin/inhaler ceiling: strict (30d/device) | observed (never below own median)
# ML_ROLLING_FOLDS=3                            # back-to-back test months for scripts/ml_cli.py rolling
# ML_GATE_MAX_SEGMENT_MAE_REGRESSION_DAYS=1.5   # gate: no segment (e.g. insulin) may lose > 1.5 d MAE
# ML_GATE_MAX_LATE_INCREASE_PP=3.0              # gate: late (stock-out) reminders may rise at most this much
# ML_GATE_MAX_COVERAGE_DROP_PP=2.0              # gate: a model may not win by sending more patients to review
# ML_DRIFT_PSI_ALERT=0.2                        # ML health: predicted-interval drift alarm
# ML_GATE_MIN_PAIRED_EVENTS=200
# ML_GATE_MIN_GAIN_PP=2.0
# ML_GATE_MAX_MAE_REGRESSION_DAYS=0.5
# ML_GATE_MAX_SEGMENT_REGRESSION_PP=5.0
