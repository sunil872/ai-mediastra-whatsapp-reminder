# ==============================================================================
# ENTERPRISE SECURITY & SENSITIVE DATA PROTECTION (.gitignore)
# ==============================================================================

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment secrets & credentials (STRICTLY FORBIDDEN FROM VERSION CONTROL)
.env
.env.*
*.pem
*.key
*.cert
credentials.json
supabase_secret.json

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Logs & Transient Operational Output (May contain customer phone numbers & outreach)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# HEALTHCARE DATA SECURITY & PII (PATIENT IDENTIFIABLE INFORMATION)
# ==============================================================================
# Database binaries (Contain full transactional patient & prescription records)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal

# Patient Datasets & Transaction Parquets (Preserved locally, never pushed)
data/refillcare/*.csv
data/refillcare/*.xlsx
data/refillcare/*.xls
data/refillcare/raw/
data/refillcare/raw_backup/
data/refillcare/backups/
data/refillcare/processed/*.parquet
data/refillcare/processed/*.db
data/refillcare/processed/*.sqlite
# Generated per run: rule A/B / rolling-test reports and newly trained registry candidates
data/refillcare/processed/ml_reports/
data/refillcare/processed/models/hgb-*.joblib
!data/refillcare/processed/models/hgb-20260617-20261016062117.joblib
data/*.csv
data/*.xlsx
data/*.parquet

# Patient Export Lists & Campaign Samples (Contain phone numbers & personal health data)
exports/*.csv
exports/*.xlsx
experiments/**/*.csv
whatsapp_campaigns/sample_data/*.csv

# Temporary, Scratch & Operating System Files
scratch/
*.tmp
*.temp
*.bak
.DS_Store
Thumbs.db
ehthumbs.db

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local Session History & Conversion Scratch
conversation_history/
file_to_markdown_converter/
converted_markdown/

# AI Agent Workspace & IDE Local Rules
.agents/
.claude/settings.local.json
.user_uploaded/
scratch*.py
test.md
desktop.ini
*.swp
*~

